# Copy this file to .env and fill in your own values:  cp .env.example .env
# DRY_RUN=true  -> emails/SMS are written to data/dry_run_mailbox/ instead of being sent
# DRY_RUN=false -> real sending/receiving with Gmail SMTP/IMAP
DRY_RUN=true

SENDER_EMAIL=your_gmail_address@gmail.com
SENDER_APP_PASSWORD=your_generated_gmail_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com

# Recipient for test emails and SMS
TEST_RECIPIENT_EMAIL=another_email@example.com
TEST_SMS_PHONE_NUMBER=1234567890
# att, verizon, tmobile, sprint, boost, cricket, us_cellular
TEST_SMS_CARRIER=att
