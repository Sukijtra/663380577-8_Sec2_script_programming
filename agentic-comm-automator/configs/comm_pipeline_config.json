{
    "initial_context": {
        "report_name": "DailySalesSummary",
        "sales_figure": 12345.67,
        "total_customers": 500
    },
    "tasks": [
        {
            "name": "Send Daily Sales Report Email",
            "type": "send_email",
            "parameters": {
                "recipients": {
                    "to": ["${TEST_RECIPIENT_EMAIL}"],
                    "cc": ["${SENDER_EMAIL}"]
                },
                "subject_template": "Daily Sales Report - {report_date}",
                "body_template": "Dear Team,\n\nPlease find the latest sales report ({report_name}) for {report_date} attached.\nTotal sales: ${sales_figure:,.2f}\nTotal active customers: {total_customers}\n\nBest regards,\nAutomated Agent",
                "attachments": [
                    "data/reports/sales_report.pdf",
                    "data/reports/summary_data.xlsx"
                ],
                "is_html": false
            },
            "output_context_key": "report_email"
        },
        {
            "name": "Send Sales Alert SMS",
            "type": "send_sms",
            "parameters": {
                "phone_numbers": ["${TEST_SMS_PHONE_NUMBER}"],
                "message_template": "Sales for {report_date} are ${sales_figure:,.2f}. Total customers: {total_customers}. Review!",
                "carrier_name": "${TEST_SMS_CARRIER}"
            }
        },
        {
            "name": "Simulate Incoming Request Email (to self)",
            "type": "send_email",
            "parameters": {
                "recipients": {
                    "to": ["${SENDER_EMAIL}"]
                },
                "subject_template": "Data Request for {report_date} - Urgent",
                "body_template": "Hello Agent,\n\nWe need the latest data for {report_date}. Please process urgently. This email includes attachments.\n\nThank you,\nClient Team\n\nThis is an urgent request for new data processing.",
                "attachments": [
                    "data/reports/sales_report.pdf"
                ],
                "is_html": false
            },
            "output_context_key": "simulated_email_sent"
        },
        {
            "name": "Process Incoming Data Requests",
            "type": "process_inbox",
            "parameters": {
                "mailbox": "INBOX",
                "search_criteria": {
                    "status": "UNSEEN",
                    "from_sender": "${SENDER_EMAIL}",
                    "subject_contains": "Data Request"
                },
                "download_attachments_base_dir": "data/incoming_attachments",
                "rules": [
                    {
                        "name": "Urgent request with attachments -> SMS alert",
                        "if": {
                            "subject_contains": "Urgent",
                            "has_attachments": true
                        },
                        "then": {
                            "send_sms_alert": true,
                            "alert_phone_numbers": ["${TEST_SMS_PHONE_NUMBER}"],
                            "alert_carrier": "${TEST_SMS_CARRIER}",
                            "alert_message_template": "URGENT: New Data Request email received from {sender} - Subject: {subject}. Attachment saved to {attachments_meta[0][filename]}"
                        }
                    },
                    {
                        "name": "New data processing request -> auto reply",
                        "if": {
                            "body_contains": "new data processing"
                        },
                        "then": {
                            "reply_with_template": "Agent received your request for '{subject}'. We are now processing the new data. You will receive an update shortly.",
                            "reply_subject_template": "Re: {subject} - Received & Processing"
                        }
                    }
                ]
            },
            "output_context_key": "processed_inbox_results"
        }
    ]
}
